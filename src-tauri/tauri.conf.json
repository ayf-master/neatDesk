{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "NeatDesk",
  "version": "0.1.0",
  "identifier": "com.neatdesk.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "NeatDesk",
        "width": 800,
        "height": 600,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": false
      },
      "wix": {
        "language": "zh-CN",
        "template": null
      }
    },
    "shortDescription": "Windows 桌面整理工具 - 按文件类型自动整理桌面",
    "longDescription": "NeatDesk 自动扫描并整理桌面文件，按文件类型（图片、文档、视频等）归类到对应的分类文件夹中。支持自定义分类规则、定时自动整理、一键撤销。",
    "publisher": "NeatDesk"
  }
}
